# =============================================================================
# Konthora Backend — Development Environment Template
# =============================================================================
# Copy this file to backend/.env and adjust values for local development.
# For production values, see backend/.env.production.example
#
# The backend only reads variables declared in app/core/config.py. Unknown
# variables are ignored, so keep this file in sync with config.py.
# =============================================================================

# --- Application runtime -----------------------------------------------------
# "development" | "testing" | "production"
# Controls startup behaviour (queues/cleanup are skipped when "testing") and
# whether HSTS is emitted (production only).
APP_ENV=development

# Bind address/port used by the local dev server (uvicorn). In production the
# API is served by systemd on 127.0.0.1:8000 behind Nginx.
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Cross-Origin Resource Sharing (CORS) -------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Development: localhost origins. Production: https://konthora.dev.bd only.
# Never use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://konthora.dev.bd

# Trust X-Forwarded-* headers from a reverse proxy.
#   false  -> development (API directly reachable)
#   true   -> production, ONLY when behind Nginx (enables correct client IP
#             extraction for rate limiting)
TRUST_PROXY_HEADERS=false

# Comma-separated allowlist of valid Host header values. Blocks DNS rebinding
# and Host header spoofing.
#   development: leave empty (any Host allowed)
#   production:  api.konthora.dev.bd
TRUSTED_HOSTS=

# GZip-compress JSON API responses. Audio/binary responses are never compressed.
COMPRESSION_ENABLED=true

# Minimum severity written to console and file logs: TRACE DEBUG INFO WARNING ERROR
LOG_LEVEL=INFO

# Directory for rotating log files. Leave empty in development (logs go to
# stdout/stderr). Production: /var/log/konthora (rotated 50 MB / 7 days / zip).
LOG_DIR=

# Seconds between periodic expired-job cleanup sweeps.
CLEANUP_INTERVAL_SECONDS=60

# Seconds after a job's expiry before its metadata record is fully purged.
CLEANUP_PURGE_AFTER_EXPIRY_SECONDS=900

# --- Text-to-Speech settings -------------------------------------------------
# Hard character ceiling per synthesis request (validated by the API schema too).
TTS_MAX_CHARACTERS=2000

# Bounded in-process queue capacity and worker count.
# Keep TTS_WORKER_COUNT=1 on the production VPS: each worker holds its own
# Kokoro model instance in memory (82M params). More workers = more RAM.
TTS_MAX_QUEUE_SIZE=10
TTS_WORKER_COUNT=1

# Retention of completed job files (minutes) before auto-deletion.
TTS_JOB_RETENTION_MINUTES=60

# Directory for generated audio + transcription job files (relative to backend/).
TTS_STORAGE_ROOT=./storage

# Default voice and speed bounds exposed to the frontend.
TTS_DEFAULT_VOICE=af_heart
TTS_MIN_SPEED=0.75
TTS_MAX_SPEED=1.25

# Boundary pause durations between chunks (milliseconds).
TTS_SENTENCE_PAUSE_MS=220
TTS_PARAGRAPH_PAUSE_MS=500

# Allow MP3 output (requires FFmpeg). WAV always works.
TTS_ENABLE_MP3=true

# Guest TTS rate limiting: max requests per client IP per sliding window.
TTS_RATE_LIMIT_REQUESTS=10
TTS_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional explicit path to the eSpeak NG installation directory. Leave empty to
# auto-discover (PATH, standard install locations, registry on Windows).
ESPEAK_PATH=

# --- Transcription settings --------------------------------------------------
# faster-whisper model size / device / compute type. On the production VPS use
# small.en / cpu / int8 (the default) to bound memory and CPU load.
TRANSCRIPTION_MODEL=small.en
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8

# Upload ceilings: max file size (MB) and max media duration (seconds).
TRANSCRIPTION_MAX_FILE_SIZE_MB=100
TRANSCRIPTION_MAX_DURATION_SECONDS=600

# Bounded queue capacity and worker count. Keep TRANSCRIPTION_WORKER_COUNT=1:
# each worker thread holds the Whisper model in memory.
TRANSCRIPTION_MAX_QUEUE_SIZE=5
TRANSCRIPTION_WORKER_COUNT=1

# Completed job retention (minutes) before result files are deleted.
TRANSCRIPTION_JOB_RETENTION_MINUTES=60

# Decoding parameters. beam_size 5 + temperature 0 = deterministic output.
TRANSCRIPTION_BEAM_SIZE=5
TRANSCRIPTION_VAD_ENABLED=true
TRANSCRIPTION_VAD_MIN_SILENCE_MS=500
TRANSCRIPTION_VAD_SPEECH_PAD_MS=400
TRANSCRIPTION_WORD_TIMESTAMPS=true

# Transcript grouping thresholds (sentence / paragraph / subtitle formatting).
TRANSCRIPTION_SENTENCE_MAX_CHARACTERS=280
TRANSCRIPTION_PARAGRAPH_MAX_CHARACTERS=900
TRANSCRIPTION_PARAGRAPH_MAX_DURATION_SECONDS=45
TRANSCRIPTION_PARAGRAPH_GAP_SECONDS=1.5
TRANSCRIPTION_SUBTITLE_MAX_CHARACTERS=84
TRANSCRIPTION_SUBTITLE_MAX_LINES=2

# Guest transcription rate limiting and concurrency.
TRANSCRIPTION_RATE_LIMIT_REQUESTS=5
TRANSCRIPTION_RATE_LIMIT_WINDOW_SECONDS=3600
TRANSCRIPTION_ACTIVE_JOBS_PER_CLIENT=1

# Media processing time ceilings (seconds) applied to FFprobe / FFmpeg.
TRANSCRIPTION_FFPROBE_TIMEOUT_SECONDS=15
TRANSCRIPTION_FFMPEG_TIMEOUT_SECONDS=120
