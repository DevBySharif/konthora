# Environment variables template for Konthora
# Rename to .env.local for local development. Do not commit your real .env.local to Git.

# Production domain url (centralized config falls back to http://localhost:3000 if not set)
NEXT_PUBLIC_SITE_URL=https://konthora.dev.bd

# Centralized contact email for support and copyright claims
NEXT_PUBLIC_CONTACT_EMAIL=hello@konthora.dev.bd

# Text to Speech backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
